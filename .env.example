TIKLEAP_API_KEY=
TIKLEAP_BASE_URL=https://api.tikleap.com
# Auth style: "bearer" -> Authorization: Bearer <key> | "x-api-key" -> x-api-key: <key>
TIKLEAP_AUTH_STYLE=bearer
# Requests per second (conservative default)
TIKLEAP_RATE_LIMIT_RPS=1
# SQLite file path
DB_PATH=./data/tikleap.db
# Collector dashboard (loopback only)
DASHBOARD_PORT=3000
# toktracker (live tracking + statistics history, loopback only)
TOKTRACKER_PORT=3100
# Tick interval of the tracker loop and max API requests per tick
TOKTRACKER_TICK_MS=30000
TOKTRACKER_MAX_REQUESTS_PER_TICK=40
